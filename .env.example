# Nightingale login
NG_BASE_URL=https://nightingale-maidmyday.azurewebsites.net
NG_EMAIL=your-nightingale-email
NG_PASSWORD=your-nightingale-password

# Service security
SERVICE_API_KEY=replace-with-a-long-random-string
HEADLESS=false
PORT=3000

# Microsoft Graph API / SharePoint upload
# From your Azure AD app registration (App registrations > your app).
MS_TENANT_ID=your-azure-ad-tenant-id
# Application (client) ID of the Azure AD app registration.
MS_CLIENT_ID=your-azure-ad-client-id
# Client secret value generated for the app registration (Certificates & secrets).
MS_CLIENT_SECRET=your-azure-ad-client-secret
# The SharePoint site's Graph "id" (e.g. via GET /sites/{hostname}:/{site-path}).
SHAREPOINT_SITE_ID=your-sharepoint-site-id
# The target document library's drive id (e.g. via GET /sites/{site-id}/drives).
SHAREPOINT_DRIVE_ID=your-sharepoint-drive-id
# Folder path inside that drive to drop files into, e.g. CustomerAcquisition/AttendanceReports
SHAREPOINT_DROPOFF_PATH=your/dropoff/folder/path

# ── n8n ───────────────────────────────────────────────────────────
# Webhook URL for the n8n workflow to trigger after a successful upload.
# Leave unset to skip the trigger (files still upload, you'd run the workflow manually).
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-webhook-id
